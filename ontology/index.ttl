qualia:macropus_giganteus a dcat:Dataset ;
    dct:title "Macropus giganteus (Eastern Grey Kangaroo) Species Hypermedia Dataset"@en ;
    dct:description "Authoritative taxonomic, UBERON anatomical, biomechanical ROM, allometric scaling, InstanceState64 ontogeny, trophic grazing, and biocultural Country dataset for Macropus giganteus Shaw, 1790 across South-Eastern Australia."@en ;
    dct:identifier <urn:qualia:taxon:macropus_giganteus> , <did:q42:taxon:macropus_giganteus> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    dct:hasPart member:taxon-ttl ,
                member:taxon-q42 ,
                member:index-q42 ,
                member:claims-ledger ,
                member:organ-cranial ,
                member:organ-axial-pelvic ,
                member:organ-limbs-tendons ,
                member:organ-osteology-myology-pelage ,
                member:cad-vibe-planned ,
                member:hmc-package-planned .

member:taxon-ttl a dcat:Distribution ;
    dct:title "Taxon & Biophysical Ontology Source (Turtle 1.1)"@en ;
    dct:format "text/turtle" ;
    dcat:accessURL <file:ontology/taxon.ttl> ;
    q42:lifecycleStatus "authored_eco_wp_11a" .

