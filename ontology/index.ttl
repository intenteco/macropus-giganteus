rel:working a dcat:Dataset ;
    dct:isVersionOf qualia:macropus_giganteus ;
    dct:identifier "working-eco-wp-11a" ;
    rdfs:comment "Single species HMC architecture: individuals instantiate Macropus giganteus via InstanceState64 (seed, ontogenetic_age_norm, height_scale, site_vigor, environmental_stress) across stages {pouch_joey, young_at_foot, subadult_flyer, adult_doe, alpha_boomer_buck}."@en .

qualia:macropus_giganteus_template a rdfs:Class ;
    rdfs:label "Macropus giganteus Organism Template (InstanceState64)"@en ;
