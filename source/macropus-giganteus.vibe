    ]
});

// 24-Joint PGA Biomechanical Rig + Two-Bone IK Grounded Contact + NLA Posture Evaluation
let hind_ik_left = capability.invoke("hypermedia.kinetics.solve_two_bone_ik", {
    root: [-0.112, 0.668, -0.088],
    target: [-0.168, 0.042, -0.145],
    pole: [-0.168, 0.520, 0.320],
    upper_length: 0.305,
    lower_length: 0.448
});
let hind_ik_right = capability.invoke("hypermedia.kinetics.solve_two_bone_ik", {
    root: [0.112, 0.668, -0.088],
    target: [0.168, 0.042, -0.145],
    pole: [0.168, 0.520, 0.320],
    upper_length: 0.305,
    lower_length: 0.448
});
let fore_ik_right = capability.invoke("hypermedia.kinetics.solve_two_bone_ik", {
    root: [0.088, 1.158, 0.068],
    target: [0.104, 0.890, 0.220],
    pole: [0.150, 0.980, -0.050],
    upper_length: 0.168,
    lower_length: 0.175
});
let nla_alert_hop = capability.invoke("hypermedia.kinetics.evaluate_nla_channelbag", {
    strips: [
        {
            name: "upright_alert_to_graze",
            start_time: 0.0,
            end_time: 1.0,
            weight: 1.0,
            blend_mode: "replace",
            start_val: [0.0, 0.14, 0.0],
            end_val: [0.0, -0.42, 0.0],
            transition: "cubic"
        },
        {
            name: "pinna_ear_swivel",
            start_time: 0.10,
            end_time: 0.90,
            weight: 0.70,
            blend_mode: "add",
            start_val: [0.0, 0.0, 0.0],
            end_val: [0.22, 0.10, -0.14],
            transition: "sine"
        }
    ],
    eval_time: 0.22
});
let fauna_rig = capability.invoke("hypermedia.kinetics.rig_biomechanical_archetype", {
    archetype: "macropod_saltatorial",
    macro_state: "alert_scan",
    speed_m_s: 0.45,
    turn_rate_rad_s: 0.02,
    dt_sec: 0.033,
    emit_emf_qac: false
});

// Woolly Silver-Grey Fur PBR Maps + Chiang Elliptical Hair BSDF + Topology/BVH 10D Compilation
let fur_maps = capability.invoke("hypermedia.surface.synthesize_maps", {
    side: 256,
    seed: 5219,
    tint: [0.50, 0.49, 0.47],
    contrast: 0.26,
    relief: 0.0035,
    bands: [32, 3],
    band_strength: 0.30,
    roughness: 0.86,
    metallic: 0.0
});
let fur_pbr_set = capability.invoke("hypermedia.surface.pack_pbr_set", {
    colour: fur_maps.colour,
    normal: fur_maps.normal,
    orm: fur_maps.orm
});
let hair_bsdf = capability.invoke("hypermedia.surface.compile_bsdf_graph", {
    closure: "chiang_hair",
    base_color: [0.48, 0.47, 0.45],
    roughness: 0.86,
    metallic: 0.0,
    ior: 1.55,
    coat_weight: 0.0,
    thin_film_nm: 0.0,
    preview_size: 128
});
let hair_bsdf_png = capability.invoke("hypermedia.radiance.encode_rgba_png", {
    image: hair_bsdf.preview_rgba
});
let pbr_10d = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
    mesh: m_axial_body,
    albedo: fur_maps.colour,
    topology: true,
    spatial_index: true,
    camera_position: [2.2, 1.05, 2.2],
    camera_target: [0.0, 0.85, -0.15],
    camera_up: [0.0, 1.0, 0.0],
    camera_fov: 38.0,
    camera_near: 0.1
});

// Endothermic Core (36.2 C, BMR 49.7 W) & Saltatorial Muscle Bioelectric .emf Volume + Spectral Slice
let kangaroo_emf = capability.invoke("hypermedia.electromagnetics.compile_emf", {
    origin: [-0.40, -0.05, -1.25],
    voxel_size: 0.08,
    grid_dims: [2, 3, 4],
    epoch_s: 1700000000.0,
    sources: [
        { position: [0.00, 0.96, 0.02],  e_amplitude: [360.0, 50.0, 90.0],  wavelength_nm: 660.0, phase: 0.00, stokes: [0.26, 0.0, 0.0] },
        { position: [0.00, 1.50, 0.25],  e_amplitude: [230.0, 38.0, 55.0],  wavelength_nm: 620.0, phase: 0.15, stokes: [0.18, 0.0, 0.0] },
        { position: [-0.14, 0.56, -0.02], e_amplitude: [340.0, 72.0, 125.0], wavelength_nm: 585.0, phase: 0.30, stokes: [0.22, 0.05, 0.0] },
        { position: [0.14, 0.56, -0.02],  e_amplitude: [340.0, 72.0, 125.0], wavelength_nm: 585.0, phase: 0.30, stokes: [0.22, 0.05, 0.0] },
        { position: [0.00, 0.18, -0.62],  e_amplitude: [160.0, 24.0, 48.0],  wavelength_nm: 510.0, phase: 0.45, stokes: [0.12, 0.0, 0.0] }
    ]
});
let spectral_slice = capability.invoke("hypermedia.electromagnetics.render_spectral_slice", {
    emf: kangaroo_emf,
    axis: "x",
    slice_index: 5,
    width: 256,
    height: 256,
    exposure: 0.0020
});
let spectral_png = capability.invoke("hypermedia.radiance.encode_rgba_png", {
    image: spectral_slice
});

// Eastern Grey Kangaroo Guttural Clucking Cough (~165 Hz) + Heavy Double Hind-Foot Ground Thump (~65 Hz) -> .qac
let raw_cough = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 165.0,
    sample_rate: 48000,
    frames: 24000,
    amplitude: 0.40
});
let filt_cough = capability.invoke("hypermedia.acoustics.filter_biquad", {
    audio: raw_cough,
    mode: "lowpass",
    cutoff_hz: 380.0,
    q: 1.3,
    gain_db: 0.0
});
let raw_thump = capability.invoke("hypermedia.acoustics.synthesize_tone", {
    frequency: 65.0,
    sample_rate: 48000,
    frames: 24000,
    amplitude: 0.62
});
let filt_thump = capability.invoke("hypermedia.acoustics.filter_biquad", {
    audio: raw_thump,
    mode: "lowpass",
    cutoff_hz: 160.0,
    q: 0.9,
    gain_db: 2.5
});
let call_mix = capability.invoke("hypermedia.acoustics.mix_tracks", {
    tracks: [
        { audio: filt_cough, gain: 0.85, offset_seconds: 0.0, fade_in_seconds: 0.03, fade_out_seconds: 0.12 },
        { audio: filt_thump, gain: 0.95, offset_seconds: 0.0, fade_in_seconds: 0.01, fade_out_seconds: 0.28 }
    ],
    master_gain: 0.92
});
let kangaroo_qac = capability.invoke("hypermedia.acoustics.encode_aac", {
    audio: call_mix,
    bitrate: 96000,
    format: "qac",
    species_id: "urn:qualia:taxon:macropus_giganteus",
    cue_profile: "acoustic_pcm_stft_hoa_modal_v1"
});

let mut asset = {files: [
    {key: "macropus-giganteus.10d", resource: assembly.container_10d},
    {key: "macropus-giganteus-pbr.10d", resource: pbr_10d},
