    {key: "turnaround.png", resource: assembly.turntable_png},
    {key: "blueprint.svg", resource: assembly.blueprint_svg},
    {key: "spectral-slice.png", resource: spectral_png},
    {key: "fur-colour.png", resource: fur_pbr_set.colour},
